            <run bold='true' fontcolor='#ffffff' fontsize='10'>Transaction Amount Daily, Weekly and Monthly</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Users_Table+ (Multiple Connections)' name='federated.00oays10g9d62g1gzkc8o1xj5lbm' />
