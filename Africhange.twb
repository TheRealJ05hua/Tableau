            <column caption='KycStatus_Label' datatype='string' name='[Calculation_1619044129718083595]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [KycStatus]&#13;&#10;    WHEN 1 THEN &quot;Not Started&quot;&#13;&#10;    WHEN 2 THEN &quot;Pending&quot;&#13;&#10;    WHEN 3 THEN &quot;Passed&quot;&#13;&#10;    WHEN 4 THEN &quot;In Review&quot;&#13;&#10;    WHEN 6 THEN &quot;Failed&quot;&#13;&#10;    ELSE &quot;Unknown&quot;&#13;&#10;END' />
