    <worksheet name='Monthly Active Users'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>Active Users Daily, Weekly and Monthly</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Users_Table+ (Multiple Connections)' name='federated.00oays10g9d62g1gzkc8o1xj5lbm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Daily' />
                <alias key='&quot;Monthly&quot;' value='Monthly' />
                <alias key='&quot;Weekly&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00oays10g9d62g1gzkc8o1xj5lbm'>
            <column caption='DateAggregationTransaction' datatype='date' datatype-customized='true' name='[Calculation_1241586186299080717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [DateCreated (Transactions!Table)])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [DateCreated (Transactions!Table)])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [DateCreated (Transactions!Table)])&#13;&#10;END)' />
            </column>
            <column caption='Transaction Bin' datatype='string' name='[Calculation_753508576751513601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 20 THEN &quot;20+ Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 10 THEN &quot;10-19 Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 5 THEN &quot;5-9 Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 3 THEN &quot;3-4 Transactions&quot;&#13;&#10;ELSE &quot;Less than 3 Transactions&quot;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[DateCreated (Transactions!Table)]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Id (Transactions!Table)]' role='dimension' type='ordinal' />
            <column caption='User Id' datatype='string' name='[UserId]' role='dimension' type='nominal' />
            <column-instance column='[UserId]' derivation='CountD' name='[ctd:UserId:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1241586186299080717]' derivation='Month-Trunc' name='[tmn:Calculation_1241586186299080717:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[Action (DateAggregationTransaction)]'>
            <groupfilter function='level-members' level='[Calculation_1241586186299080717]' user:ui-action-filter='[Action4_7EB928B293FB4268AF58AC7698C03637]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[Action (Transaction Bin)]'>
            <groupfilter function='level-members' level='[Calculation_753508576751513601]' user:ui-action-filter='[Action4_34DB3C1724444767864C8C0540E580D5]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.00oays10g9d62g1gzkc8o1xj5lbm].[Action (DateAggregationTransaction)]</column>
            <column>[federated.00oays10g9d62g1gzkc8o1xj5lbm].[Action (Transaction Bin)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[ctd:UserId:qk]' scope='rows' value='false' />
            <format attr='title' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[tmn:Calculation_1241586186299080717:qk]' scope='cols' value='' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#fbfbfe' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='stroke-size' scope='rows' value='0' />
            <format attr='line-visibility' scope='rows' value='off' />
