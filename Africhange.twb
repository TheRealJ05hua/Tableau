    <dashboard name='Insights' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Key Insights</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98128' id='1' param='vert' removable='false' type-v2='layout-flow' w='98962' x='519' y='936'>
            <zone h='5848' id='3' type-v2='title' w='98962' x='519' y='936' />
            <zone h='11813' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98962' x='519' y='6784' />
            <zone h='80467' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98962' x='519' y='18597'>
              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='User Analysis' captured-sheet='' id='1' />
                  <story-point caption='Transaction Analysis&#9;' captured-sheet='' id='2' />
                  <story-point caption='Retention Analysis&#9;' captured-sheet='' id='3' />
                  <story-point caption='Funnel Insights&#9;' captured-sheet='' id='4' />
                  <story-point caption='Recommendation' captured-sheet='' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='89578' hidden='true' id='6' story-point-id='1' type-v2='text' w='32731' x='744' y='17866'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>1. User Analysis</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Steady Growth</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: User acquisition shows a consistent increase across daily, weekly, and monthly views.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Verification Drop-off</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: A noticeable percentage of users remain non-verified even after profile completion.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Engagement Gaps</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: Average transaction volume per user is skewed by a few high performers.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Demographics</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Gender</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: Skewed towards males.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Age Range</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: Majority between 20–29.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Locations</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: High concentration in urban centers like Lagos and Abuja.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Profession</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: Top users are College and University Students</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='79901' hidden='true' id='9' story-point-id='3' type-v2='text' w='98377' x='519' y='19727'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>3. Retention Analysis</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Monthly Active Users (MAU)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> and </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Weekly Active Users (WAU)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> show peaks that align with promotional campaigns from lunching remained fairly steady after that how the transaction volume was oscillating and ultimately attenuated at the end of the period. Show that while at the use remain fairly the variesy according to periods.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Users with </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>&gt;10 transactions</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> are significantly more likely to stay active month over month.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Churn rate</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> increases after 2–3 weeks of inactivity.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='68070' hidden='true' id='10' story-point-id='4' type-v2='text' w='92987' x='519' y='18596'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>4. Funnel Analysis</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Major drop-offs between &quot;Completed Profile&quot; and &quot;KYC Verification&quot; stage (~30%).</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Transaction stage retains only ~40% of original acquisitions.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Conversion Rates</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>:</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Profile Completion: ~59%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>KYC Verification (of Profile Completed): ~34%</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Transacting Users (of Onboarded): ~375%  - Implying users are able to carry out transactions having not completed their profiles or had KYC verification</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='45380' hidden='true' id='11' story-point-id='2' type-v2='text' w='89026' x='519' y='18596'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>2. Transactions Insights</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Volume Spikes</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: Significant transaction volume on weekends and during holidays. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>Top Professions</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> in transaction volume: Developers, Traders, and Students. </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>High-Volume Locations</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>: Lagos, Ontario and Alberta, indicating a volume on the CAD-NGN and NGN-CAD currency corridor </run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='77895' id='12' story-point-id='5' type-v2='text' w='89545' x='519' y='18596'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Recommendations</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>1. Improve Verification Funnel</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Introduce </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>gamified onboarding</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> or </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>instant KYC support chat</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> to push users from Profile Completion to Verification.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Send </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>automated reminders/emails</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> for users who haven’t completed KYC.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>2. Boost User Retention</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Implement a </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>“Win-back” campaign</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> targeting users with 1–2 transactions and &gt;1 week inactivity.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Add </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>streak rewards or loyalty points</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> for weekly transactions.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>3. Enhance Personalization</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Use demographic insights to push </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>profession-specific promotions</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> (e.g., for freelancers or students).</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Deploy </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>location-based offers</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> (e.g., free transfers in specific states).</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>4. Increase Average Volume</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Enable </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>bulk transaction discounts</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Promote </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>saving or transfer bundles</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> after every 5 transactions.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>5. Funnel Optimization</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Consider </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>in-app nudges</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> between each funnel step.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Introduce </run>
            <run bold='true' fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>progress bars</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Times New Roman' fontsize='12'> showing how close a user is to becoming a verified, transacting member.</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run fontalignment='0'>Æ&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ  </run>
          </formatted-text>
        </zone>
      </zones>
