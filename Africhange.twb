      <column caption='Transaction Bin' datatype='string' name='[Calculation_753508576751513601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 20 THEN &quot;20+ Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 10 THEN &quot;10-19 Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 5 THEN &quot;5-9 Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 3 THEN &quot;3-4 Transactions&quot;&#13;&#10;ELSE &quot;Less than 3 Transactions&quot;&#13;&#10;END' />
