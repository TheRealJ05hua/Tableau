    <worksheet name='Funnel Visualization'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Users_Table+ (Multiple Connections)' name='federated.00oays10g9d62g1gzkc8o1xj5lbm' />
          </datasources>
          <datasource-dependencies datasource='federated.00oays10g9d62g1gzkc8o1xj5lbm'>
            <column caption='Complete Profile Count' datatype='integer' name='[Calculation_753508576759689218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([CompletedProfile] = TRUE, 1, 0))' />
            </column>
            <column caption='KYC Verified Count' datatype='integer' name='[Calculation_753508576761581571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([IsKYCVerified] = TRUE, 1, 0))' />
            </column>
            <column caption='Transacting Users' datatype='integer' name='[Calculation_753508576770981895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : COUNTD(IF NOT ISNULL([UserId]) THEN [UserId] END) }' />
            </column>
            <column caption='Stage' datatype='string' name='[Calculation_753508576804634632]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE TRUE&#13;&#10;      WHEN NOT ISNULL(COUNT([Id])) THEN &quot;Acquisition&quot;&#13;&#10;      WHEN NOT ISNULL([Calculation_753508576759689218]) THEN &quot;Complete Profile&quot;&#13;&#10;      WHEN NOT ISNULL([Calculation_753508576761581571]) THEN &quot;KYC Verified&quot;&#13;&#10;      WHEN NOT ISNULL(COUNT([Calculation_753508576770981895])) THEN &quot;Transaction&quot;&#13;&#10;&#13;&#10;    &#13;&#10;END' />
            </column>
            <column caption='Funnel Stage' datatype='integer' name='[Calculation_753508576823648265]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Calculation_753508576804634632]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN 1&#13;&#10;    WHEN &quot;Complete Profile&quot; THEN 2&#13;&#10;    WHEN &quot;KYC Verified&quot; THEN 3&#13;&#10;    WHEN &quot;Transaction&quot; THEN 4&#13;&#10;END' />
            </column>
            <column caption='Completed Profile' datatype='boolean' name='[CompletedProfile]' role='dimension' type='nominal' />
            <column datatype='string' name='[Id]' role='dimension' type='nominal' />
            <column caption='Is KYC Verified' datatype='boolean' name='[IsKYCVerified]' role='dimension' type='nominal' />
            <column caption='User Id' datatype='string' name='[UserId]' role='dimension' type='nominal' />
            <column-instance column='[Id]' derivation='CountD' name='[ctd:Id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_753508576770981895]' derivation='Sum' name='[sum:Calculation_753508576770981895:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_753508576759689218]' derivation='User' name='[usr:Calculation_753508576759689218:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_753508576761581571]' derivation='User' name='[usr:Calculation_753508576761581571:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_753508576804634632]' derivation='User' name='[usr:Calculation_753508576804634632:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_753508576823648265]' derivation='User' name='[usr:Calculation_753508576823648265:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_753508576804634632:nk]' direction='ASC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_753508576823648265:ok]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_753508576759689218:qk]' field-type='quantitative' max='23002' min='0' range-type='fixed' scope='cols' type='space' />
            <encoding attr='space' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_753508576761581571:qk]' field-type='quantitative' max='23002' min='0' range-type='fixed' scope='cols' type='space' />
            <encoding attr='space' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[sum:Calculation_753508576770981895:qk]' field-type='quantitative' max='23002' min='0' range-type='fixed' scope='cols' type='space' />
            <format attr='title' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[ctd:Id:qk]' scope='cols' value='Onboarded User' />
            <format attr='title' class='0' field='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_753508576759689218:qk]' scope='cols' value='Completed User Profile' />
