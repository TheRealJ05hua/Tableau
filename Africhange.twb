      </column>
      <column caption='WoW Growth' datatype='real' name='[Calculation_1619044129730318349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL(COUNTD([Id]), 0) - LOOKUP(IFNULL(COUNTD([UserId]), 0), -1)) &#13;&#10;/ ABS(LOOKUP(IFNULL(COUNTD([Id]), 0), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Filter' datatype='datetime' name='[Calculation_1619044129750118415]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [DateCreated])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [DateCreated])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [DateCreated])&#13;&#10;END' />
