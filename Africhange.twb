    <worksheet name='Corridor (Monthly) Volume Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Users_Table+ (Multiple Connections)' name='federated.00oays10g9d62g1gzkc8o1xj5lbm' />
          </datasources>
          <datasource-dependencies datasource='federated.00oays10g9d62g1gzkc8o1xj5lbm'>
            <column caption='Base Amount' datatype='integer' name='[BaseAmount]' role='measure' type='quantitative' />
            <column caption='Age' datatype='integer' name='[Calculation_1241586186212044804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [DateOfBirth], TODAY())' />
            </column>
            <column caption='Currency Corridor' datatype='string' name='[Calculation_1241586186272989194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[SendCurrencyId] + &quot; - &quot; + [ReceiveCurrencyId]' />
            </column>
            <column caption='Growth Amount' datatype='real' name='[Calculation_1241586186291326988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([BaseAmount]) - LOOKUP(SUM([BaseAmount]), -1)) / LOOKUP(SUM([BaseAmount]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='date' name='[DateCreated (Transactions!Table)]' role='dimension' type='ordinal' />
            <column caption='Date Of Birth' datatype='date' name='[DateOfBirth]' role='dimension' type='ordinal' />
            <column caption='Receive Currency Id' datatype='string' name='[ReceiveCurrencyId]' role='dimension' type='nominal' />
            <column caption='Send Currency Id' datatype='string' name='[SendCurrencyId]' role='dimension' type='nominal' />
            <column-instance column='[DateCreated (Transactions!Table)]' derivation='Month' name='[mn:DateCreated (Transactions!Table):ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1241586186272989194]' derivation='None' name='[none:Calculation_1241586186272989194:nk]' pivot='key' type='nominal' />
            <column-instance column='[BaseAmount]' derivation='Sum' name='[sum:BaseAmount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1241586186212044804]' derivation='Sum' name='[sum:Calculation_1241586186212044804:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1241586186291326988]' derivation='User' name='[usr:Calculation_1241586186291326988:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-type='ColumnInPane' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[:Measure Names]'>
            <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_1241586186291326988:qk:4]&quot;' user:op='manual' />
          </filter>
          <computed-sort column='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[mn:DateCreated (Transactions!Table):ok]' direction='ASC' using='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[sum:Calculation_1241586186212044804:qk]' />
          <shelf-sorts>
