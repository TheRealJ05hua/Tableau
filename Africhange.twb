    <worksheet name='Transaction Conversion Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='Users_Table+ (Multiple Connections)' name='federated.00oays10g9d62g1gzkc8o1xj5lbm' />
          </datasources>
          <datasource-dependencies datasource='federated.00oays10g9d62g1gzkc8o1xj5lbm'>
            <column caption='KYC Verified Count' datatype='integer' name='[Calculation_753508576761581571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([IsKYCVerified] = TRUE, 1, 0))' />
            </column>
            <column caption='Transaction Conversion Rate' datatype='real' name='[Calculation_753508576765906950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_753508576770981895]) / [Calculation_753508576761581571]' />
            </column>
            <column caption='Transacting Users' datatype='integer' name='[Calculation_753508576770981895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : COUNTD(IF NOT ISNULL([UserId]) THEN [UserId] END) }' />
            </column>
            <column caption='Is KYC Verified' datatype='boolean' name='[IsKYCVerified]' role='dimension' type='nominal' />
            <column caption='User Id' datatype='string' name='[UserId]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_753508576765906950]' derivation='User' name='[usr:Calculation_753508576765906950:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[usr:Calculation_753508576765906950:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{993AE027-7AC9-42DA-A798-D6E2D859B3C2}' />
    </worksheet>
    <worksheet name='Transaction Count'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Book'>Users who have made a transaction</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Users_Table+ (Multiple Connections)' name='federated.00oays10g9d62g1gzkc8o1xj5lbm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Daily' />
                <alias key='&quot;Monthly&quot;' value='Monthly' />
                <alias key='&quot;Weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Top N Occupation' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;10&quot;'>
              <calculation class='tableau' formula='&quot;10&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00oays10g9d62g1gzkc8o1xj5lbm'>
            <column caption='Base Amount' datatype='integer' name='[BaseAmount]' role='measure' type='quantitative' />
            <column caption='Age' datatype='integer' name='[Calculation_1241586186212044804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [DateOfBirth], TODAY())' />
            </column>
            <column caption='Top N Occupation' datatype='integer' name='[Calculation_1241586186236416008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;ALL&quot; THEN 1&#13;&#10;ELSEIF RANK_DENSE(COUNTD([Id])) &lt;= INT([Parameters].[Parameter 2]) THEN 1&#13;&#10;ELSE 0&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Growth Amount' datatype='real' name='[Calculation_1241586186291326988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([BaseAmount]) - LOOKUP(SUM([BaseAmount]), -1)) / LOOKUP(SUM([BaseAmount]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DateAggregationTransaction' datatype='date' datatype-customized='true' name='[Calculation_1241586186299080717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [DateCreated (Transactions!Table)])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [DateCreated (Transactions!Table)])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [DateCreated (Transactions!Table)])&#13;&#10;END)' />
            </column>
            <column caption=' User Transaction Count' datatype='integer' name='[Calculation_1241586186323636238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [UserId] : COUNT([Id (Transactions!Table)]) }' />
            </column>
            <column caption='Extract Year' datatype='integer' name='[Calculation_1619044129692389376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([DateCreated (Transactions!Table)])' />
            </column>
            <column caption='Extract_Year' datatype='integer' name='[Calculation_1619044129698566149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([DateCreated])' />
            </column>
            <column caption='Growth' datatype='real' name='[Calculation_1619044129766731793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(COUNTD([Id]), 0) - LOOKUP(IFNULL(COUNTD([Id]), 0), -1)) / ABS(LOOKUP(IFNULL(COUNTD([Id]), 0), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Vol User' datatype='real' name='[Calculation_1619044129914875925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([BaseAmount]) / COUNTD([UserId])' />
            </column>
            <column caption='Avg Vol per User' datatype='real' name='[Calculation_1619044129915097110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([BaseAmount]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Complete Profile Count' datatype='integer' name='[Calculation_753508576759689218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([CompletedProfile] = TRUE, 1, 0))' />
            </column>
            <column caption='KYC Verified Count' datatype='integer' name='[Calculation_753508576761581571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([IsKYCVerified] = TRUE, 1, 0))' />
            </column>
            <column caption='Complete Profile Conversion Rate' datatype='real' name='[Calculation_753508576765173764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_753508576759689218] / COUNTD([Id])' />
            </column>
            <column caption='KYC Verified Conversion Rate' datatype='real' name='[Calculation_753508576765493253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_753508576761581571]/[Calculation_753508576759689218]' />
            </column>
            <column caption='Transacting Users' datatype='integer' name='[Calculation_753508576770981895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : COUNTD(IF NOT ISNULL([UserId]) THEN [UserId] END) }' />
            </column>
            <column caption='Stage' datatype='string' name='[Calculation_753508576804634632]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE TRUE&#13;&#10;      WHEN NOT ISNULL(COUNT([Id])) THEN &quot;Acquisition&quot;&#13;&#10;      WHEN NOT ISNULL([Calculation_753508576759689218]) THEN &quot;Complete Profile&quot;&#13;&#10;      WHEN NOT ISNULL([Calculation_753508576761581571]) THEN &quot;KYC Verified&quot;&#13;&#10;      WHEN NOT ISNULL(COUNT([Calculation_753508576770981895])) THEN &quot;Transaction&quot;&#13;&#10;&#13;&#10;    &#13;&#10;END' />
            </column>
            <column caption='Funnel Stage' datatype='integer' name='[Calculation_753508576823648265]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Calculation_753508576804634632]&#13;&#10;    WHEN &quot;Acquisition&quot; THEN 1&#13;&#10;    WHEN &quot;Complete Profile&quot; THEN 2&#13;&#10;    WHEN &quot;KYC Verified&quot; THEN 3&#13;&#10;    WHEN &quot;Transaction&quot; THEN 4&#13;&#10;END' />
            </column>
            <column caption='Completed Profile' datatype='boolean' name='[CompletedProfile]' role='dimension' type='nominal' />
            <column datatype='date' name='[DateCreated (Transactions!Table)]' role='dimension' type='ordinal' />
