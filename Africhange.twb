          <datasource-dependencies datasource='federated.00oays10g9d62g1gzkc8o1xj5lbm'>
            <column caption='Base Amount' datatype='integer' name='[BaseAmount]' role='measure' type='quantitative' />
            <column caption='DateAggregationTransaction' datatype='date' datatype-customized='true' name='[Calculation_1241586186299080717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [DateCreated (Transactions!Table)])&#13;&#10;    WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [DateCreated (Transactions!Table)])&#13;&#10;    WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [DateCreated (Transactions!Table)])&#13;&#10;END)' />
            </column>
            <column caption='Transaction Bin' datatype='string' name='[Calculation_753508576751513601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 20 THEN &quot;20+ Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 10 THEN &quot;10-19 Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 5 THEN &quot;5-9 Transactions&quot;&#13;&#10;ELSEIF { FIXED [UserId]: COUNT([Id (Transactions!Table)]) } &gt;= 3 THEN &quot;3-4 Transactions&quot;&#13;&#10;ELSE &quot;Less than 3 Transactions&quot;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[DateCreated (Transactions!Table)]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Id (Transactions!Table)]' role='dimension' type='ordinal' />
            <column caption='User Id' datatype='string' name='[UserId]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1241586186299080717]' derivation='None' name='[none:Calculation_1241586186299080717:qk]' pivot='key' type='quantitative' />
            <column-instance column='[BaseAmount]' derivation='Sum' name='[sum:BaseAmount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.00oays10g9d62g1gzkc8o1xj5lbm].[Action (Transaction Bin)]'>
